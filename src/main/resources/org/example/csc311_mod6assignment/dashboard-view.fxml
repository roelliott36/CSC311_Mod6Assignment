<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="674.0" prefWidth="1203.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.csc311_mod6assignment.dashboardController">

    <children>

        <ImageView fx:id="dashboardBackground" fitHeight="679.0" fitWidth="1203.0" pickOnBounds="true" preserveRatio="false">
            <image>
                <Image url="@dashboard_background.png" />
            </image>
        </ImageView>

        <TextField fx:id="fileNameTextDisplay" editable="false" layoutX="1060.0" layoutY="36.0" prefHeight="25.0" prefWidth="118.0" promptText="File name" />

        <Button fx:id="uploadFileButton" layoutX="1066.0" layoutY="76.0" mnemonicParsing="false" onAction="#uploadFile" prefHeight="41.0" prefWidth="106.0" text="Upload .csv file" />

        <TextField fx:id="dateRangeTextDisplay" editable="false" layoutX="922.0" layoutY="84.0" prefHeight="25.0" prefWidth="114.0" promptText="Date range" />

        <Button fx:id="monthlyAverageButton" layoutX="20.0" layoutY="152.0" onAction="#showMonthlyAverage" prefWidth="135.0" text="Monthly Average" />

        <Button fx:id="thresholdDaysButton" layoutX="20.0" layoutY="193.0" onAction="#showDaysAboveThreshold" prefHeight="35.0" prefWidth="135.0" text="Days Above Temp" />

        <Label fx:id="avgTempLabel" layoutX="273.0" layoutY="164.0" text="Average Temperature" />

        <Label fx:id="rainyDaysLabel" layoutX="531.0" layoutY="164.0" text="Rainy Days" />

        <Label fx:id="avgHumidityLabel" layoutX="777.0" layoutY="164.0" text="Average Humidity" />

        <Label fx:id="totalDaysLabel" layoutX="1032.0" layoutY="164.0" text="Total Days" />

        <Label fx:id="avgTempNumberDisplay" layoutX="273.0" layoutY="197.0" text="--" />

        <Label fx:id="tempBasedOnDataLabel" layoutX="273.0" layoutY="225.0" text="Based on imported data" />

        <Label fx:id="numDaysNumberDisplay" layoutX="531.0" layoutY="197.0" text="--" />

        <Label fx:id="rainyBasedOnDataLabel" layoutX="531.0" layoutY="225.0" text="Days with precipitation &gt; 0" />

        <Label fx:id="avgHumidityPercentDisplay" layoutX="777.0" layoutY="197.0" text="--" />

        <Label fx:id="humidityBasedOnDataLabel" layoutX="777.0" layoutY="225.0" text="Based on imported data" />

        <Label fx:id="totalDaysNumDisplay" layoutX="1035.0" layoutY="197.0" text="--" />

        <Label fx:id="totalDaysBasedOnDataLabel" layoutX="1035.0" layoutY="225.0" text="Based on imported data" />

        <Label fx:id="importedDataViewLabel" layoutX="201.0" layoutY="269.0" prefHeight="25.0" prefWidth="150.0" text="Imported Data View" />

        <TableView fx:id="importedDataViewTable" layoutX="201.0" layoutY="296.0" prefHeight="156.0" prefWidth="472.0">
            <columns>
                <TableColumn fx:id="importedDataDateView" prefWidth="112.0" text="Date" />
                <TableColumn fx:id="importedDataTempView" prefWidth="119.0" text="Temperature" />
                <TableColumn fx:id="importedDataHumidityView" prefWidth="116.0" text="Humidity" />
                <TableColumn fx:id="importedDataPrecipitationView" prefWidth="124.0" text="Precipitation" />
            </columns>
        </TableView>

        <BarChart fx:id="precipitationVsHumidity" animated="false" layoutX="701.0" layoutY="269.0" prefHeight="184.0" prefWidth="479.0" title="Precipitation &amp; Humidity">
            <xAxis>
                <CategoryAxis label="Date" side="BOTTOM" />
            </xAxis>
            <yAxis>
                <NumberAxis label="Value" side="LEFT" />
            </yAxis>
        </BarChart>

        <PieChart fx:id="tempCategoriesPieChart" animated="false" layoutX="201.0" layoutY="477.0" prefHeight="173.0" prefWidth="200.0" title="Temperature Categories" />

        <Label fx:id="hotLabel" layoutX="408.0" layoutY="518.0" text="Hot (&gt;= 85°F)" />

        <Label fx:id="warmLabel" layoutX="407.0" layoutY="552.0" text="Warm (65–84°F)" />

        <Label fx:id="coldLabel" layoutX="407.0" layoutY="587.0" text="Cold (&lt; 65°F)" />

        <MenuButton fx:id="selectRankingMenuDropdown" layoutX="506.0" layoutY="477.0" mnemonicParsing="false" text="Select Ranking">
            <items>
                <MenuItem fx:id="top5HottestDays" mnemonicParsing="false" text="Top 5 Hottest Days" />
                <MenuItem fx:id="top5ColdestDays" mnemonicParsing="false" text="Top 5 Coldest Days" />
            </items>
        </MenuButton>

        <Button fx:id="applyRankingButton" disable="true" layoutX="781.0" layoutY="474.0" mnemonicParsing="false" onAction="#applyRanking" prefHeight="15.0" prefWidth="111.0" text="Apply Ranking" />

        <TableView fx:id="rankedViewTable" layoutX="506.0" layoutY="516.0" prefHeight="131.0" prefWidth="390.0">
            <columns>
                <TableColumn fx:id="rankedDataDateView" prefWidth="91.0" text="Date" />
                <TableColumn fx:id="rankedDataTempView" prefWidth="102.0" text="Temperature" />
                <TableColumn fx:id="rankedDataHumidityView" minWidth="7.0" prefWidth="91.0" text="Humidity" />
                <TableColumn fx:id="rankedDataPrecipitationView" prefWidth="105.0" text="Precipitation" />
            </columns>
        </TableView>

        <Label fx:id="summaryLabel" layoutX="922.0" layoutY="481.0" prefHeight="17.0" prefWidth="118.0" text="Summary" />

        <TextArea fx:id="summaryTextArea" editable="false" layoutX="922.0" layoutY="510.0" prefHeight="137.0" prefWidth="256.0" wrapText="true" />

    </children>
</Pane>
